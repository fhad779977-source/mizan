# ═══════════════════════════════════════════════════════════
# X Arabic Clean — إعدادات الخادم
# انسخ هذا الملف إلى .env (في جذر المشروع أو داخل server/) ثم عبّئ المفاتيح.
# لا تضع هذه المفاتيح داخل كود الإضافة أبدًا — تبقى على الخادم فقط.
# ═══════════════════════════════════════════════════════════

# منفذ الخادم
PORT=8787

# auto  = يستخدم المزود الحقيقي إذا وُجد مفتاحه، وإلا وضع التجربة
# mock  = وضع التجربة دائمًا (نص تجريبي واضح)
# live  = يرفض التشغيل إذا كانت المفاتيح ناقصة
PROVIDER_MODE=auto

# مفتاح OpenAI (للتفريغ الصوتي Whisper + فحص المحتوى omni-moderation + الترجمة اختياريًا)
OPENAI_API_KEY=

# مفتاح Anthropic (اختياري — للترجمة عبر Claude)
ANTHROPIC_API_KEY=

# اختيار المزود لكل مرحلة: openai | anthropic | mock
TRANSCRIPTION_PROVIDER=openai
MODERATION_PROVIDER=openai
TRANSLATION_PROVIDER=anthropic

# النماذج
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_TRANSLATE_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-opus-5-5

# حماية اختيارية: إذا عيّنتها يجب إدخال نفس الرمز في إعدادات الإضافة
ACCESS_TOKEN=

# السماح فقط لمعرّفات إضافات محددة (مفصولة بفاصلة). فارغ = أي إضافة Chrome + localhost
ALLOWED_EXTENSION_IDS=

# الحد الأقصى لحجم مقطع الصوت المرسل (ميغابايت)
MAX_AUDIO_MB=10
